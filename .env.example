# Stripe sandbox keys. Dashboard > Developers > API keys (sandbox).
STRIPE_SECRET_KEY=sk_test_...

# The recurring Price for "Premium", $12.99 USD monthly. Dashboard > Product catalog.
STRIPE_PRICE_ID=price_...

# Signing secret for the webhook endpoint. From `stripe listen` locally, or
# Workbench > Webhooks > destination details on Vercel.
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL used to build success_url and cancel_url. Vercel sets VERCEL_URL
# automatically; set this to the production domain once you have one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
